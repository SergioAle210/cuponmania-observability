# Copiar a .env y ajustar. Ningún valor aquí es secreto.
ELASTIC_VERSION=9.5.5
# Perfil de AWS CLI (IAM Identity Center) con permiso LecturaLogsPreprod en cuponmania-preprod.
AWS_PROFILE=cuponmania-preprod
# Carpeta con la configuración y la caché de sesión de AWS CLI (se monta solo lectura en Filebeat).
AWS_CONFIG_DIR=~/.aws
